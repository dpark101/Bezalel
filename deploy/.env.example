# =============================================================================
# Bezalel.AI — Environment Variables
#
# Copy this file to /data/bezalel/backend/.env and fill in real values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# ── Database ────────────────────────────────────────────────────────────────
# Async PostgreSQL connection string (asyncpg driver).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://bezalel:CHANGE_ME@localhost:5432/bezalel

# ── Authentication / JWT ────────────────────────────────────────────────────
# Secret key for signing JWT tokens. Generate with: openssl rand -hex 64
SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-64

# JWT signing algorithm (HS256 recommended for symmetric keys)
JWT_ALGORITHM=HS256

# How long access tokens remain valid (in hours)
JWT_EXPIRY_HOURS=24

# Account lockout: max failed login attempts before lockout
MAX_FAILED_LOGINS=5

# Account lockout: duration in minutes
LOCKOUT_MINUTES=30

# ── SMTP (for OTP/verification emails) ─────────────────────────────────────
# Gmail SMTP settings (use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=noreply@bezalel.ai
SMTP_USE_TLS=true

# ── Google OAuth 2.0 ───────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://www.danieltaehyunpark.com/api/auth/google/callback

# ── Microsoft OAuth 2.0 ────────────────────────────────────────────────────
# Register app at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=https://www.danieltaehyunpark.com/api/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

# ── Anthropic (Claude AI) ──────────────────────────────────────────────────
# API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── iMessage Bridge ────────────────────────────────────────────────────────
# Master key for the iMessage integration service
IMESSAGE_MASTER_KEY=your-imessage-master-key

# ── Symmetric Encryption ───────────────────────────────────────────────────
# Fernet-compatible 32-byte URL-safe base64 key for encrypting sensitive data.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# ── Frontend Origin (CORS) ─────────────────────────────────────────────────
# URL of the Next.js frontend for CORS allow-origin header
FRONTEND_ORIGIN=https://www.danieltaehyunpark.com

# ── Backup Encryption ──────────────────────────────────────────────────────
# GPG passphrase for encrypting database backups (used by backup.sh)
BACKUP_GPG_PASSPHRASE=your-backup-encryption-passphrase
